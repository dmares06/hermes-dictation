<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>WhisperDict</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dmares06.whisperdict</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>whisperdict</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>WhisperDict uses the microphone to convert your speech to text on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>WhisperDict uses on-device speech recognition so the keyboard can dictate directly into other apps.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>WhisperDict reads your upcoming events and adds the ones you approve, so Hermes can answer questions about your schedule and put things on it.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>WhisperDict adds the reminders you dictate to the Reminders app so they can alert you.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>WhisperDictRealtimeClientToken</key>
	<string>$(WHISPERDICT_CLIENT_TOKEN)</string>
</dict>
</plist>
